# Configuração do servidor STT API
# Copie para .env e ajuste

# --- STT (Whisper) ---
WHISPER_MODEL=large-v3
WHISPER_COMPUTE=int8_float16

# Lista de GPUs visíveis para o Whisper (separadas por vírgula).
# No compose, stt-api enxerga só a GPU física 1 como cuda:0
# (CUDA_VISIBLE_DEVICES=1) — o compose já define WHISPER_GPUS=cuda:0.
# Múltiplas GPUs aqui = round-robin entre workers.
WHISPER_GPUS=cuda:0

# --- Refinamento (llama.cpp / OpenAI-compatible) ---
REFINE_BASE_URL=http://llama-refine:8080/v1  # nome do serviço no docker-compose
REFINE_API_KEY=
REFINE_MODEL=Qwen3-8B

# --- Hugging Face (opcional, acelera download dos modelos) ---
# Obtenha em: https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Gerais ---
MAX_FILE_SIZE_MB=500
SESSION_TIMEOUT_MIN=60
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
