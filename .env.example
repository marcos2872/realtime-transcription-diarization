# Copy to .env and adjust. Every variable maps 1:1 to a Settings field
# (prefix TRANSCRIPT_). The running .env also holds TRANSCRIPT_HF_TOKEN
# (secret — never commit it).

# --- server ---
TRANSCRIPT_HOST=0.0.0.0
TRANSCRIPT_PORT=8000
TRANSCRIPT_MAX_STREAMS=4
TRANSCRIPT_SAMPLE_RATE=16000
TRANSCRIPT_LANGUAGE=auto
TRANSCRIPT_EMIT_PARTIALS=true

# --- ASR (transcription) ---
TRANSCRIPT_ASR_PROVIDER=nemotron
TRANSCRIPT_ASR_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
TRANSCRIPT_CHUNK_MS=320
TRANSCRIPT_LOOKAHEAD_S=1.4

# --- diarization ---
TRANSCRIPT_DIARIZATION_PROVIDER=pyannote
TRANSCRIPT_DIARIZATION_PIPELINE=pyannote/speaker-diarization-community-1
TRANSCRIPT_DIARIZATION_WINDOW_S=30
TRANSCRIPT_DIARIZATION_HOP_S=5
TRANSCRIPT_DIARIZATION_OVERLAP_S=7
TRANSCRIPT_DIARIZATION_MIN_S=10

# --- environment / credentials ---
TRANSCRIPT_DEVICE=auto
# Accept the conditions at
# https://huggingface.co/pyannote/speaker-diarization-community-1
# and paste a token from https://huggingface.co/settings/tokens :
TRANSCRIPT_HF_TOKEN=

# --- test frontend (docker compose `web` service) ---
# Must be reachable FROM THE BROWSER (it opens the API WebSocket directly).
WEB_API_URL=http://localhost:8000
WEB_PORT=3000

# --- local HTTPS (docker compose `proxy` service, Caddy + `tls internal`) ---
# Exposes https://<host>/ (front) and https://<host>/api/* (API as wss://).
HTTPS_PORT=443
