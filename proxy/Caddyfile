# Termina TLS com certificado da CA interna do Caddy e roteia:
#   https://<host>/          -> front Next.js (web:3000)
#   https://<host>/api/*     -> API (transcript:8000, prefixo /api removido)
#
# Uso no front: digite https://<host>/api no campo "URL da API"
# (o WebSocket vira wss:// automaticamente).
{
	auto_https off
	admin off
}

:443 {
	# Certificado interno emitido sob demanda para qualquer host/IP
	# (localhost, 127.0.0.1, IP da LAN, ...). O navegador exibe um aviso
	# na primeira visita ("Não seguro" -> Avançado -> prosseguir); após
	# aceitar uma vez, a página é contexto seguro e o microfone funciona.
	tls internal {
		on_demand
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy transcript:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
